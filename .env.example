# AWS Configuration
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here

# DynamoDB Configuration
USER_TABLE_NAME=Users

# JWT Authentication Configuration
# Secret key for signing JWT tokens (REQUIRED)
# IMPORTANT: Must be at least 32 characters long for security
# Generate a secure random string for production use
JWT_SECRET_KEY=your-jwt-secret-key-at-least-32-characters-long

# SES Email Configuration
# Verified sender email address for password reset emails (REQUIRED)
# IMPORTANT: This email must be verified in AWS SES before use
# For sandbox mode, recipient emails must also be verified
FROM_EMAIL=noreply@yourdomain.com

# AWS region for SES service (REQUIRED)
# Must match the region where your SES email/domain is verified
SES_REGION=us-east-1

# Frontend base URL for password reset links (REQUIRED)
# Used to construct the reset link sent in emails
# Example: https://your-frontend-domain.com or http://localhost:3000 for local dev
BASE_URL=http://localhost:3000

# SES Configuration Set name for event tracking (OPTIONAL)
# Leave empty if not using SES configuration sets
# Configuration sets enable tracking of email delivery events (bounces, complaints, etc.)
CONFIGURATION_SET_NAME=

# CORS Configuration
# Allowed origin for CORS headers
# IMPORTANT: Never include a trailing slash - browsers send Origin without one
# Production: https://the-tax-app.vercel.app
# Local development: http://localhost:3001 (or your local frontend URL)
# Use '*' only for testing (not recommended for production)
CORS_ALLOWED_ORIGIN=https://the-tax-app.vercel.app

# Optional: For local development with SAM CLI
# SAM_CLI_TELEMETRY=0

# Optional: For testing with specific AWS profile
# AWS_PROFILE=your-profile-name

# Optional: Lambda Configuration (if needed for local testing)
# LAMBDA_TIMEOUT=30
# LAMBDA_MEMORY_SIZE=512
