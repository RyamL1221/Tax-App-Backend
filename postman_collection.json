    {
      "name": "Tax Document Generation",
      "item": [
        {
          "name": "Generate 1099-DIV - Complete Form",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "description": "JWT token from login (automatically set)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"1099-DIV\",\n  \"formData\": {\n    \"payerName\": \"Vanguard Investments\",\n    \"payerStreetAddress\": \"100 Vanguard Blvd\",\n    \"payerCity\": \"Malvern\",\n    \"payerState\": \"PA\",\n    \"payerCountry\": \"USA\",\n    \"payerZip\": \"19355\",\n    \"payerPhone\": \"800-662-7447\",\n    \"payerTIN\": \"23-1945930\",\n    \"recipientTIN\": \"123-45-6789\",\n    \"recipientName\": \"John Doe\",\n    \"recipientStreetAddress\": \"456 Main St, Apt 2B\",\n    \"recipientCity\": \"Boston\",\n    \"recipientState\": \"MA\",\n    \"recipientCountry\": \"USA\",\n    \"recipientZip\": \"02101\",\n    \"accountNumber\": \"12345678\",\n    \"calendarYear\": \"2025\",\n    \"totalOrdinaryDividends\": 5000.00,\n    \"qualifiedDividends\": 3000.00,\n    \"totalCapitalGainDistributions\": 1500.00,\n    \"federalIncomeTaxWithheld\": 500.00,\n    \"section199ADividends\": 2000.00\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3000/Prod/generate",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["Prod", "generate"]
            },
            "description": "Generate a complete Form 1099-DIV with payer, recipient, and dividend information. Requires JWT token from login."
          },
          "response": []
        },
