            },
            "url": {
              "raw": "http://localhost:3000/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["register"]
            },
            "description": "Register a new user with valid email, name, and strong password"
          },
          "response": []
